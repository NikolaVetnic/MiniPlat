{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "noEmit": true,
    "skipLibCheck": true,

    /* Under migreringen ligger produksjonskoden fortsatt i .js/.jsx. De tas med slik at
       importer fra .ts lar seg slå opp, men typesjekkes ikke - hver fil begynner å bli
       sjekket i det den får .ts-endelse. Begge fjernes når siste fil er migrert. */
    "allowJs": true,
    "checkJs": false,

    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  "include": ["src"]
}
